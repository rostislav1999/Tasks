@model List<PizzaApp.Models.PizzaModel>  <!-- Указываем тип модели -->

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пиццы</title>
</head>
<body>
    <h1>Список пицц</h1>

    <ul>
        @foreach (var pizza in Model)
        {
            <li>
                <h3>@pizza.Name</h3>
                <img src="@pizza.Image" alt="@pizza.Name" width="100" height="100" />
                <p><strong>Состав:</strong> @string.Join(", ", pizza.Composition)</p>
                <p><strong>Размеры:</strong> @string.Join(", ", pizza.Sizes)</p>
                <p><strong>Тесто:</strong> @pizza.Crust</p>
                <p><strong>Цена:</strong> @pizza.Price руб.</p>
                <p><strong>Вес:</strong> @pizza.Weight</p>
            </li>
        }
    </ul>
</body>
</html>