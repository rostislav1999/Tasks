@using System.Linq
@using PizzaApp.Models
@model List<PizzaModel>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Доставка Пиццы и Роллов</title>
    <link rel="stylesheet" href="~/css/site.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <header>
        <h1>Доставка пиццы и роллов</h1>
        <div class="working-hours">
            <p>Понедельник – Пятница: с 10:00 до 22:00</p>
            <p>Суббота: с 10:00 до 22:30</p>
        </div>
    </header>
    <main>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Task1</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <section class="menu">
            <div class="menu-flex">
                @if (Model == null || !Model.Any())
                {
                    <p>Пиццы не найдены.</p>
                }
                else
                {
                    @foreach (var pizza in Model)
                    {
                        <div class="menu-item">
                            <h5>@pizza.Id</h5>
                            <h3 class="pizza-name" data-id="@pizza.Id">@pizza.Name</h3>
                            <img class="pizza-image" data-id="@pizza.Id" src="@pizza.Image" alt="@pizza.Name" width="200" height="200" />
                            <p>@string.Join(", ", pizza.Ingredients)</p>
                            <p>@pizza.Price руб.</p>
                        </div>
                    }
                }
            </div>
        </section>
    </main>
    <footer>
        <div class="contacts">
            <p>Телефон: +7 902 127-77-72</p>
            <p>Альтернативный номер: 4-04-77</p>
        </div>
    </footer>

    <!-- Модальное окно -->
    <div class="modal fade" id="pizzaModal" tabindex="-1" aria-labelledby="pizzaModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="pizzaModalLabel">Описание пиццы</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <img id="modalImage" src="" alt="" class="img-fluid mb-3">
                    <h3 id="modalName"></h3>
                    <p><strong>Ингредиенты:</strong> <span id="modalIngredients"></span></p>
                    <p><strong>Цена:</strong> <span id="modalPrice"></span> руб.</p>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('.menu').on('click', '.pizza-name', function () {
                // Находим родительский контейнер с данными о пицце
                var pizzaItem = $(this).closest('.menu-item');

                // Извлекаем данные о пицце из DOM
                var name = pizzaItem.find('.pizza-name').text();
                var ingredients = pizzaItem.find('p').first().text();  // Первая параграф с ингредиентами
                var price = pizzaItem.find('p').last().text();  // Последний параграф с ценой
                var imageSrc = pizzaItem.find('.pizza-image').attr('src');

                // Заполняем модальное окно
                $('#modalImage').attr('src', imageSrc);
                $('#modalName').text(name);
                $('#modalIngredients').text(ingredients);
                $('#modalPrice').text(price);

                // Открываем модальное окно
                $('#pizzaModal').modal('show');
            });
        });
    </script>
</body>
</html>