@model IEnumerable<PizzaApp.Models.PizzaModel>

<h1>Pizza Menu</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pizza in Model)
        {
            <tr>
                <td>@pizza.Id</td>
                <td>@pizza.Name</td>
                <td>@pizza.Price</td>
            </tr>
        }
    </tbody>
</table>

<script>
    // Ожидаем загрузки DOM
    document.addEventListener('DOMContentLoaded', function () {
        // Выполняем запрос сразу после загрузки страницы
        fetch('/Pizza/GetPizzas')  // Предполагаем, что это путь для получения списка пицц
            .then(response => response.json())
            .then(data => {
                console.log(data);  // Можно выполнить что-то с данными, например, отобразить
                // Здесь можно обработать или вывести данные на странице
            })
            .catch(error => {
                console.error('Error fetching pizzas:', error);
            });
    });
</script>