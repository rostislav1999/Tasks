@model IEnumerable<PizzaApp.Models.PizzaModel>

<h1>Pizza Menu</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pizza in Model)
        {
            <tr>
                <td>@pizza.Id</td>
                <td>@pizza.Name</td>
                <td>@pizza.Price</td>
            </tr>
        }
    </tbody>
</table>