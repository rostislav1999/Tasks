@model PizzaApp.Models.PizzaModel

<!DOCTYPE html>
<html>
<head>
    <title>@Model.Name - Pizza Details</title>
    <link rel="stylesheet" href="css/site.css">
</head>
<body>
    <div class="container">
        <img src="@Url.Content(Model.Image)"
             onerror="this.src='/images/placeholder.jpg';"
             alt="@Model.Name"
             class="pizza-image" />
        <h1 class="pizza-name">
            <a href="/Pizza/Index" class="pizza-link">@Model.Name</a>
        </h1>
        <p class="pizza-price">Price: $@Model.Price</p>
        <a href="/Pizza/Index" class="back-button">Back to Menu</a>
    </div>
</body>
</html>