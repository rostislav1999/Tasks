<div id="pizza-list"></div>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script> <!-- Подключение jQuery -->

<script>
    // Данные пиццы (эти данные должны быть переданы с сервера)
    const pizzas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    // Контейнер для списка
    const container = document.getElementById('pizza-list');

    // Генерация элементов с пиццами
    pizzas.forEach(pizza => {
        const div = document.createElement('div');
        div.classList.add('menu-item');

        div.innerHTML =
            <h5>${pizza.id}</h5>
            <h3>
                <a href="/Pizza/Detail/${pizza.id}">${pizza.name}</a>
            </h3>
            <img class="pizza-image" data-id="${pizza.id}" src="${pizza.image}" alt="${pizza.name}" width="200" height="200" />
            <p>${pizza.ingredients.join(', ')}</p>
            <p>${pizza.price} руб.</p>
        ;
        container.appendChild(div);
    });

    // Привязка события click на картинку
    $(document).on('click', '.pizza-image', function () {
        const pizzaId = $(this).data('id'); // Получаем ID пиццы
        window.location.href = /Pizza/Detail/${pizzaId}; // Переход на страницу Details
    });
</script>