<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Доставка Пиццы и Роллов</title>
    <link rel="stylesheet" href="~/css/site.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <header>
        <h1>Доставка пиццы и роллов</h1>
    </header>
    <main>
        <section class="categories">
            <p><strong>Роллы, закуски, салаты, десерты, напитки, горячие блюда, детское меню, сувениры.</strong></p>
        </section>
        <section class="menu">
            <div class="menu-flex">
                <ul id="pizzas-list">

                </ul>
            </div>  <!-- Это будет контейнер для динамически добавленных пицц -->
        </section>
    </main>
    <footer>
        <div class="contacts">
            <p>Телефон: +7 902 127-77-72</p>
            <p>Альтернативный номер: 4-04-77</p>
        </div>
    </footer>
    <script>
             $.ajax({
            url: '/api/pizza',  // Путь к API
            method: 'GET',
            success: function(data) {
                // Печатаем данные, полученные с сервера
                console.log(data);  // Посмотрим, что приходит в data

                var pizzasList = $('#pizzas-list');
                pizzasList.empty();  // Очищаем предыдущий список

                // Проходим по каждому элементу в data и проверяем, что там
                data.forEach(function(pizza) {
                    console.log(pizza);  // Печатаем каждый объект pizza
                    pizzasList.append(
                                         `<img src="${pizza.image}" alt="${pizza.name}" />
                            <h2>${pizza.name}</h2>
                            <p>Состав: ${pizza.composition.join(", ")}</p>
                            <p>Размеры: ${pizza.sizes.join(", ")}</p>
                            <p>Корочка: ${pizza.crust}</p>
                            <p class="price">${pizza.price} Р ${pizza.weight}</p>`
                    );
                });
            },
            error: function(error) {
                console.error("Ошибка при получении пицц: ", error);
            }
        });
    </script>
</body>
</html>